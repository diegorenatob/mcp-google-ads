# =============================================================================
# mcp-google-ads — environment variables
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# NEVER commit `.env`.
# =============================================================================

# --- Server --------------------------------------------------------------------
# Public URL Claude uses to reach the server (no trailing slash).
PUBLIC_URL=https://mcp.example.com
# Domain used by the Traefik labels in docker-compose.yml.
MCP_DOMAIN=mcp.example.com
PORT=8080
# Traefik integration used by docker-compose.yml labels.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
LOG_LEVEL=info

# --- MCP login (built-in OAuth used by Claude web) -----------------------------
# Access key requested on the login page when connecting from Claude.
# Generate one with: openssl rand -base64 32
MCP_ACCESS_KEY=change-me-to-a-long-random-key
# Secret used to sign access tokens (JWT). Generate with: openssl rand -hex 32
MCP_JWT_SECRET=change-me
# Lifetime of the tokens issued by the MCP server.
MCP_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_REFRESH_TOKEN_TTL_DAYS=30
# Allowed OAuth redirect URIs (comma-separated).
# Empty = Claude's default callback URLs (see docs/CLAUDE_WEB.md).
MCP_ALLOWED_REDIRECT_URIS=

# --- Google Ads API (server-side credentials) ----------------------------------
# Google Cloud OAuth client (type: Desktop app).
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
# Refresh token with scope https://www.googleapis.com/auth/adwords
# Obtain it with: npm run google:auth  (see docs/GOOGLE_ADS_SETUP.md)
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
# Optional since 2026 (access is now managed per Google Cloud project).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Advertiser (NOT manager) account with billing. Digits only.
GOOGLE_ADS_CUSTOMER_ID=1234567890
# Manager account (MCC) used to access it. Digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Optional allowlist of accounts the server may query (comma-separated, digits only).
# Empty = discover them from the manager account.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=
GOOGLE_ADS_API_VERSION=v23

# --- Behaviour -----------------------------------------------------------------
# explorer | basic  -> "basic" enables the Keyword Planner tools with volumes.
GOOGLE_ADS_ACCESS_LEVEL=explorer
# Daily budget of operations against production accounts (Explorer = 2,880).
GOOGLE_ADS_DAILY_OPS_BUDGET=2500
# Default language/country for the tools.
DEFAULT_LANGUAGE_CODE=pt
DEFAULT_COUNTRY_CODE=BR
# Response cache in hours (0 = disabled).
CACHE_TTL_HOURS=24
